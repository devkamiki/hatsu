{
  "name": "hatsu",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal webmail with OpenPGP, CalDAV and CardDAV",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test src/server/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.3",
    "imapflow": "^1.2.4",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.11",
    "openpgp": "^6.2.2",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.0",
    "tsdav": "^2.1.5",
    "tsx": "^4.20.6",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
